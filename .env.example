# Copy this file to .env and keep the real .env out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional LangSmith tracing for graph/model visibility.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=project-13-campuspath-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

ENVIRONMENT=development
ACADEMIC_DB_PATH=data/academic_operations.db
CHECKPOINT_DB_PATH=data/agent_checkpoints.db
AUDIT_LOG_PATH=data/audit/agent_events.jsonl
MAX_AGENT_STEPS=28
MAX_TOOL_RETRIES=3
STANDARD_MAX_CREDITS=22

